import { Request, Response, NextFunction } from 'express';
import Redis from 'ioredis';

const redis = new Redis(process.env.REDIS_URL || 'redis://localhost:6379');

const LOCK_TTL_SECONDS = 30;       // Short lock while request is in-flight
const CACHE_TTL_SECONDS = 86400;   // 24-hour idempotency replay window

interface CachedResponse {
  status: number;
  body: unknown;
}

/**
 * Distributed Idempotency Middleware
 * Guarantees at-most-once execution across horizontally scaled API nodes.
 */
export async function idempotencyMiddleware(
  req: Request,
  res: Response,
  next: NextFunction
): Promise<void> {
  const idempotencyKey = req.header('X-Idempotency-Key');

  if (!idempotencyKey) {
    res.status(400).json({ error: 'Missing required X-Idempotency-Key header' });
    return;
  }

  const cacheKey = `idem:resp:${idempotencyKey}`;
  const lockKey = `idem:lock:${idempotencyKey}`;

  try {
    // 1. Fast-path: Check if this mutation was already processed
    const existing = await redis.get(cacheKey);
    if (existing) {
      const parsed: CachedResponse = JSON.parse(existing);
      res.setHeader('X-Idempotent-Replay', 'true');
      res.status(parsed.status).json(parsed.body);
      return;
    }

    // 2. Acquire distributed atomic lock (NX = Set only if Not Exists)
    const lockAcquired = await redis.set(lockKey, process.env.NODE_ID || 'node', 'EX', LOCK_TTL_SECONDS, 'NX');
    if (!lockAcquired) {
      // Another API node is actively processing a concurrent retry of this exact key
      res.status(409).json({
        error: 'Concurrent request in progress for this idempotency key. Retry shortly.',
      });
      return;
    }

    // 3. Intercept response to persist outcome atomically before releasing lock
    const originalJson = res.json.bind(res);
    res.json = (body: unknown): Response => {
      if (res.statusCode >= 200 && res.statusCode < 500) {
        const payload: CachedResponse = { status: res.statusCode, body };
        redis
          .multi()
          .set(cacheKey, JSON.stringify(payload), 'EX', CACHE_TTL_SECONDS)
          .del(lockKey)
          .exec()
          .catch((err) => console.error('Failed to persist idempotency result:', err));
      } else {
        // Release lock on 5xx server errors so client retries can recover
        redis.del(lockKey).catch(() => {});
      }
      return originalJson(body);
    };

    next();
  } catch (err) {
    console.error('Idempotency layer failure:', err);
    // Fail-open or fail-closed depending on domain criticality; fail-closed protects inventory integrity
    res.status(503).json({ error: 'Sync gateway temporarily unavailable' });
  }
}
